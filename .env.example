# --- Jira Cloud connection -------------------------------------------------
# Your site URL, no trailing slash. Also used to build "open in Jira" links.
JIRA_BASE_URL=https://yourcompany.atlassian.net
# The Atlassian account the API token belongs to.
JIRA_EMAIL=dashboard-bot@yourcompany.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Only needed for *scoped* API tokens. Find it at
# https://yourcompany.atlassian.net/_edge/tenant_info
JIRA_CLOUD_ID=

# --- Dashboard ---------------------------------------------------------------
# Password for the /admin page.
ADMIN_PASSWORD=change-me
# Port and interface the server listens on.
PORT=3000
HOST=0.0.0.0
# Where config.json and state.json are stored.
DATA_DIR=./data
# Set to 1 to run against built-in fake data instead of Jira.
JIRA_MOCK=0
